# Copy to .env.local for local development. Never commit .env.local.

# Studdy environment: local | development | staging | production
STUDDY_ENVIRONMENT=local
NEXT_PUBLIC_STUDDY_ENVIRONMENT=local

# Local Supabase (values printed by `pnpm supabase:start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:14321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<local anon key from supabase start>

# Server-only — never expose in NEXT_PUBLIC_*, never commit a real value.
# Local key comes from `pnpm supabase:start`; Development key is supplied privately.
SUPABASE_SERVICE_ROLE_KEY=<local service role key>

# Direct Postgres connection for server-side data access (local Supabase default).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:14322/postgres

# Shared secret for scheduled jobs (e.g. /api/jobs/expire-requests).
# The scheduler sends it as: Authorization: Bearer <value>
# Server-only, never NEXT_PUBLIC_. Generate with: openssl rand -base64 32
CRON_SECRET=local-development-cron-secret

# Inngest — the production scheduler for request/payment-window expiry.
# BOTH ARE SERVER-ONLY. Never NEXT_PUBLIC_: a signing key in the browser bundle
# would let anyone invoke Studdy's scheduled work.
#
# REQUIRED in any deployed (cloud-mode) environment. The SDK verifies Inngest's
# signature with it; without it, invocations are refused and expiry silently
# never runs. Optional locally: `npx inngest-cli@latest dev` runs an unsigned
# dev server and the endpoint reports "mode":"dev".
INNGEST_SIGNING_KEY=
# OPTIONAL, and genuinely so. The SDK only requires an event key inside
# `inngest.send()`, which throws "Failed to send event" in cloud mode when it is
# missing. Studdy runs a cron function and sends no events, so nothing reads it
# — a deployment must not fail merely because it is absent. Set it when the
# first event-driven function exists.
INNGEST_EVENT_KEY=

# Stripe Connect — tutor payout onboarding (feat/stripe-connect-onboarding).
# BOTH ARE SERVER-ONLY. Never NEXT_PUBLIC_: the secret key can move money and
# create accounts, and the webhook secret is what makes a forged event
# distinguishable from a real one.
#
# Use TEST-MODE keys (sk_test_...). Live mode requires explicit approval.
STRIPE_SECRET_KEY=

# The signing secret for the CONNECT webhook endpoint specifically. Stripe
# issues a different secret per endpoint, and Connect events are delivered to a
# separate endpoint from account events — using the wrong one fails every
# signature check with a message that looks like tampering.
# Local value comes from `stripe listen --forward-to ...`.
STRIPE_CONNECT_WEBHOOK_SECRET=

# The absolute origin Stripe returns tutors to after hosted onboarding.
# Falls back to VERCEL_URL, then http://localhost:3000. Set it explicitly
# anywhere the deployed origin is not what VERCEL_URL reports.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The Payment Element needs Stripe.js in the browser, so this key is PUBLIC by
# design and NEXT_PUBLIC_ on purpose — it can only act on a PaymentIntent whose
# client secret the server already handed to the owning family. It is the ONLY
# Stripe key permitted client-side; the secret key never leaves the server.
#
# Use the TEST publishable key (pk_test_...) from the SAME sandbox as
# STRIPE_SECRET_KEY. A mismatched pair fails at confirmation with an error that
# looks like a card problem — see the sandbox gotcha in the handoff §7.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Copy to .env.local for local development. Never commit .env.local.

# Studdy environment: local | development | staging | production
STUDDY_ENVIRONMENT=local
NEXT_PUBLIC_STUDDY_ENVIRONMENT=local

# Local Supabase (values printed by `pnpm supabase:start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:14321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<local anon key from supabase start>

# Server-only — never expose in NEXT_PUBLIC_*, never commit a real value.
# Local key comes from `pnpm supabase:start`; Development key is supplied privately.
SUPABASE_SERVICE_ROLE_KEY=<local service role key>

# Direct Postgres connection for server-side data access (local Supabase default).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:14322/postgres

# Shared secret for scheduled jobs (e.g. /api/jobs/expire-requests).
# The scheduler sends it as: Authorization: Bearer <value>
# Server-only, never NEXT_PUBLIC_. Generate with: openssl rand -base64 32
CRON_SECRET=local-development-cron-secret
